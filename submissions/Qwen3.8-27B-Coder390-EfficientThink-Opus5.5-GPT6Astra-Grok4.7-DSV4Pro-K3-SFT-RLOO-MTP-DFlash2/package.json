{
  "name": "h2h-task-scheduler",
  "version": "1.0.0",
  "description": "Production-ready in-memory task scheduler (1M tasks) with priorities, execution timestamps, dependency tracking, dynamic updates, cycle detection, and O(log n) next-executable-task retrieval.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --expose-gc node_modules/jest/bin/jest.js",
    "test:watch": "node --expose-gc node_modules/jest/bin/jest.js --watch",
    "test:memory": "node --expose-gc node_modules/jest/bin/jest.js --testPathPattern scale",
    "demo": "tsc -p examples.tsconfig.json && node dist-demo/examples/demo.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.9.3"
  }
}
